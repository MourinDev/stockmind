# Connection pooled do Neon (host com "-pooler"). Usada pela aplicação.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require"

# Connection direta do Neon (sem "-pooler"). Usada pelo Prisma migrate.
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=require"

# Segredo do JWT da sessão. Não use o prefixo NEXT_PUBLIC_.
# Gere com: openssl rand -base64 32
SESSION_SECRET="troque-este-valor"
